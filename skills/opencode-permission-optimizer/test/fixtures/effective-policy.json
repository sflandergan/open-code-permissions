{
  "agents": [
    {
      "id": "implement",
      "name": "implement",
      "mode": "subagent",
      "hidden": false,
      "rules": [
        {
          "action": "*",
          "resource": "*",
          "effect": "ask",
          "position": 0,
          "origin": { "scope": "shared", "source": "opencode.json" }
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask",
          "position": 1,
          "origin": { "scope": "shared", "source": "opencode.json" }
        },
        {
          "action": "shell",
          "resource": "*>*",
          "effect": "ask",
          "position": 2,
          "origin": { "scope": "shared", "source": "opencode.json" }
        },
        {
          "action": "shell",
          "resource": "rm -rf *",
          "effect": "deny",
          "position": 3,
          "origin": { "scope": "shared", "source": "opencode.json" }
        },
        {
          "action": "shell",
          "resource": "git status",
          "effect": "allow",
          "position": 4,
          "origin": { "scope": "agent", "source": ".opencode/agents/implement.md" }
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow",
          "position": 5,
          "origin": { "scope": "agent", "source": ".opencode/agents/implement.md" }
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow",
          "position": 6,
          "origin": { "scope": "unknown", "source": null }
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow",
          "position": 7,
          "origin": { "scope": "agent", "source": ".opencode/agents/implement.md" }
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow",
          "position": 8,
          "origin": { "scope": "shared", "source": "opencode.json" }
        }
      ]
    },
    {
      "id": "explore",
      "name": "explore",
      "mode": "subagent",
      "hidden": false,
      "rules": [
        {
          "action": "*",
          "resource": "*",
          "effect": "ask",
          "position": 0,
          "origin": { "scope": "unknown", "source": null }
        }
      ]
    }
  ]
}

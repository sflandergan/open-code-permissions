{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": { "*": "ask" },
    "edit": { "*": "deny" },
    "read": { "*": "allow" },
    "skill": { "legacy-skill": "deny", "opencode-permission-optimizer": "deny" },
    "webfetch": "ask"
  },
  "agent": {
    "plan": { "disable": true },
    "build": { "disable": true },
    "explore": { "model": "openai/gpt-5.6-sol" },
    "ghost": {
      "hidden": true,
      "description": "hidden fixture agent",
      "permission": {
        "read": { "opencode.json": "allow" }
      }
    }
  }
}

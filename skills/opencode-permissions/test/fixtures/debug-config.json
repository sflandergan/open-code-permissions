[
  {
    "type": "document",
    "path": "/home/example/.config/opencode/opencode.json",
    "info": {
      "permissions": [
        {
          "action": "webfetch",
          "resource": "example.test/*",
          "effect": "deny"
        }
      ]
    }
  },
  {
    "type": "document",
    "path": "$REPOSITORY_ROOT/opencode.json",
    "info": {
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "opencode-permission-optimizer",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ],
      "agents": {
        "plan": {
          "disabled": true
        },
        "explore": {
          "model": {
            "providerID": "openai",
            "model": "gpt-5.6-sol"
          }
        },
        "ghost": {
          "hidden": true,
          "description": "hidden fixture agent",
          "permissions": [
            {
              "action": "read",
              "resource": "opencode.json",
              "effect": "allow"
            },
            {
              "action": "subagent",
              "resource": "*",
              "effect": "deny"
            }
          ]
        }
      }
    }
  },
  {
    "type": "document",
    "path": "$REPOSITORY_ROOT/opencode.jsonc",
    "info": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ],
      "agents": {}
    }
  },
  {
    "type": "directory",
    "path": "$REPOSITORY_ROOT/.opencode"
  }
]

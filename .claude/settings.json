{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Grep(./**)",
      "Glob(./**)",
      "Read(./**)",

      "Edit(./**)",
      "Write(./**)",

      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git grep:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git rebase:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git pull)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(test:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",

      "Bash(bash *scripts/fetch-pr-comments.sh:*)",
      "Bash(bash *scripts/create-bug-issue.sh:*)",
      "Bash(bash *scripts/publish-branch.sh)",
      "Bash(bash *scripts/publish-branch.sh --existing-pr * --expected-head * --head-branch *)",
      "Bash(bash *scripts/publish-and-ready.sh)",
      "Bash(bash *scripts/ensure-fresh.sh:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(bash .agents/scripts/ui-design/preview.sh start)",
      "Bash(bash .agents/scripts/ui-design/preview.sh probe)",
      "Bash(bash .agents/scripts/ui-design/preview.sh stop)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(bash *scripts/reply-to-pr-comment.sh:*)",
      "Bash(bash *scripts/update-bug-issue.sh:*)"
    ],
    "deny": [
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)"
    ]
  }
}

{
  "name": "opencode-permissions",
  "version": "0.1.0",
  "description": "OpenCode plugin and skills for recording and reviewing permission observations.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./.opencode/plugins/permission-optimizer/index.ts"
  },
  "files": [
    ".opencode/plugins/permission-optimizer",
    "!.opencode/plugins/permission-optimizer/test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./.opencode ./skills ./scripts ./test",
    "check-package": "bun scripts/check-package.ts",
    "mark-internal-skills": "bun scripts/mark-internal-skills.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@opencode/plugin": "2.3.2",
    "@types/bun": "^1.4.4",
    "typescript": "~6.0.3"
  }
}
